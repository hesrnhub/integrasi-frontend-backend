          "example": 1
        },
        "name": {
          "type": "string",
          "example": "Nasi Goreng"
        },
        "price": {
          "type": "number",
          "example": 15000
        },
        "isAvailable": {
          "type": "boolean",
          "example": true
        }
      },
      "required": [
        "stallId",
        "name",
        "price",
        "isAvailable"
      ]
    },
    "ReviewInput": {
      "type": "object",
      "properties": {
        "stallId": {
          "type": "number",
          "example": 1
        },
        "userId": {
          "type": "number",
          "example": 2
        },
        "rating": {
          "type": "number",
          "example": 5
        },
        "comment": {
          "type": "string",
          "example": "Enak"
        }
      },
      "required": [
        "stallId",
        "userId",
        "rating"
      ]
    },
    "LikeInput": {
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "number",
          "example": 1
        },
        "userId": {
          "type": "number",
          "example": 2
        }
      },
      "required": [
        "reviewId",
        "userId"
      ]
    },
