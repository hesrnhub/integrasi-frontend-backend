        },
        "category": {
          "type": "string",
          "example": "Nasi"
        },
        "location": {
          "type": "string",
          "example": "Kantin FK"
        },
        "description": {
          "type": "string",
          "example": ""
        }
      },
      "required": [
        "name"
      ]
    },
    "StallReviewInput": {
      "type": "object",
