      "type": "object",
      "properties": {
        "userId": {
          "type": "number",
          "example": 1
        },
        "action": {
          "type": "string",
          "example": "CREATE"
        },
        "targetTable": {
          "type": "string",
          "example": "MENU_ITEMS"
        },
        "targetId": {
          "type": "number",
          "example": 1
        },
        "metadata": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "example": "api"
            }
          }
        }
      },
      "required": [
